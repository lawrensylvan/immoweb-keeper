# Copy this file to config.prod.env and replace the secret before deploying.
JWT_SECRET=replace-with-a-long-random-secret

# The application is loopback-only until a reverse proxy is introduced.
PROD_APP_PORT=8080

# Absolute host path where downloaded production images will be stored.
# The directory must already exist before deploying.
PROD_IMAGES_PATH=/absolute/path/to/immoweb-keeper/images

# Absolute host path where persistent production logs will be stored.
# The directory must already exist before deploying.
PROD_LOGS_PATH=/absolute/path/to/immoweb-keeper/logs

# Routine log files older than this many days are removed when a run starts.
ROUTINE_LOG_RETENTION_DAYS=90
