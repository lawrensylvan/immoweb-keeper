# <!> This is an example configuration file. You should edit this file and rename it to config.env

###############################
### Download routine config ###
###############################

# Estate metadata will be saved to this db. These defaults connect to the
# MongoDB container started from the project root with `npm run db:start`.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=immoweb_dev

# Local filesystem path where estate pictures are saved
IMAGE_OUTPUT_PATH=../dev/images

# Optional development-only cap applied separately to each postal-code/property-type search.
# Leave unset in production.
MAX_ESTATES_PER_SEARCH=5

###############################
######## Server config ########
###############################

# React app should use that port number to connect (only relevant for development)
PORT=5001

# JSON Web Token secret (should be a random string)
JWT_SECRET=<any random string>

# Folder from where to serve static image assets
SHOULD_SERVE_IMAGES=true
IMAGE_SOURCE_PATH=../../dev/images
